# Copy to .env and adjust for your setup. EXPO_PUBLIC_ variables are inlined into the JS bundle
# at build/start time — never put a secret here, only the gateway's public address.

# Web preview / simulator on this machine:
EXPO_PUBLIC_API_URL=http://localhost:8080

# Physical device on the same Wi-Fi: use this machine's LAN IP instead of localhost.
# EXPO_PUBLIC_API_URL=http://192.168.0.10:8080
